# ─── Discord Bot ───
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
GUILD_ID=YOUR_GUILD_ID

# ─── Admin Webhook (private channel for transaction logs) ───
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ─── Feedback Channel (Kênh gửi lời cảm ơn đơn hàng) ───
FEEDBACK_CHANNEL_ID=YOUR_FEEDBACK_CHANNEL_ID

# ─── Minecraft Server ───
MC_SERVER_HOST=donutsmp.net
MC_SERVER_PORT=25565
MC_EMAIL=your_microsoft_email@outlook.com

# ─── Bank / Payment API ───
# Casso API Key (or any VietQR-compatible service)
BANK_API_KEY=YOUR_CASSO_API_KEY
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
BANK_BIN=YOUR_BANK_BIN
BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# ─── Web Panel ───
WEB_PORT=3000

# ─── Gạch Thẻ Cào (Card Partner API) ───
CARD_DOMAIN=https://trumthengon.com
CARD_PARTNER_ID=YOUR_CARD_PARTNER_ID
CARD_PARTNER_KEY=YOUR_CARD_PARTNER_KEY
